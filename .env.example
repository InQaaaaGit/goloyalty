# Адрес запуска сервера
RUN_ADDRESS=:8080

# Подключение к базе данных PostgreSQL
DATABASE_URI=postgres://user:password@localhost:5432/gophermart?sslmode=disable

# Адрес системы расчёта начислений
ACCRUAL_SYSTEM_ADDRESS=http://localhost:8081

# Секретный ключ для JWT (обязательно измените в продакшене!)
JWT_SECRET=your-super-secret-key-change-in-production

# Время жизни JWT токена (по умолчанию 24 часа)
JWT_EXPIRATION=24h

# Настройки cookies
COOKIE_NAME=auth_token
COOKIE_PATH=/
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false 